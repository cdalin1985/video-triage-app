# ── Tier B: judgment (required) ─────────────────────────────────
# Validation, brief, confidence score, and post-approval ACT builds.
ANTHROPIC_API_KEY=

# ── Tier A: extraction (free tier — aistudio.google.com/apikey) ──
# Gemini Flash reads frames + caption and writes search queries.
# If unset, extraction falls back to Claude Haiku (cheap, not free).
GEMINI_API_KEY=

# ── Search: claim verification (one of these; both optional) ─────
# Chain is Linkup → Tavily → none. Set whichever you have; Linkup wins
# if both are present.
# Linkup: linkup.so — $20/mo recurring credit ≈ 4,000 searches, no card
LINKUP_API_KEY=
# Tavily: tavily.com — 1,000 free searches/month, no card
TAVILY_API_KEY=

# ── Optional model overrides ─────────────────────────────────────
# JUDGE_MODEL=claude-sonnet-5
# EXTRACT_FALLBACK_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-2.5-flash
