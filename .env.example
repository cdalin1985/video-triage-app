# ── Tier B: judgment (required) ─────────────────────────────────
# Validation, brief, confidence score, and post-approval ACT builds.
# Runs on OpenAI (GPT-5 series) by default. Get a key at
# platform.openai.com/api-keys — NOTE: API billing is separate from a
# ChatGPT subscription; a ChatGPT Plus/Pro plan does NOT grant API access.
OPENAI_API_KEY=

# ── Tier A: extraction (free tier — aistudio.google.com/apikey) ──
# Gemini Flash reads frames + caption and writes search queries.
# If unset, extraction falls back to Claude Haiku (needs ANTHROPIC_API_KEY).
GEMINI_API_KEY=

# ── Extraction fallback (optional) ──────────────────────────────
# Only used if GEMINI_API_KEY is unset or Gemini errors. Not needed if you
# rely on Gemini. Also lets you route judgment back to Anthropic by setting
# JUDGE_MODEL=claude-... below.
ANTHROPIC_API_KEY=

# ── Search: claim verification (one of these; both optional) ─────
# Chain is Linkup → Tavily → none. Set whichever you have; Linkup wins
# if both are present.
# Linkup: linkup.so — $20/mo recurring credit ≈ 4,000 searches, no card
LINKUP_API_KEY=
# Tavily: tavily.com — 1,000 free searches/month, no card
TAVILY_API_KEY=

# ── Optional model overrides ─────────────────────────────────────
# JUDGE_MODEL routes by name: gpt-*/o* → OpenAI, claude-* → Anthropic.
# JUDGE_MODEL=gpt-5.5
# EXTRACT_FALLBACK_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-2.5-flash
